# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Variables de entorno y secretos locales
.env
.env.*
!.env.example

# Salidas de compilacion (los modulos ya traen sus propias reglas)
build/
bin/
target/
out/
.gradle/

# Metadatos de IDE
.project
.classpath
.settings/
.idea/
*.iml
.vscode/

# El wrapper de Gradle es codigo: no lo excluye la regla *.jar
!**/gradle/wrapper/gradle-wrapper.jar
